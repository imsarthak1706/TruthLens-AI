        "अभी भुगतान",
        "आज ही",
        "तुरंत साझा",
        "तुरंत बताइए",
        "तुरंत बताओ",

        # Hinglish
        "abhi share karo",
        "abhi share kijiye",
        "abhi karo",
        "turant karo",
        "turant pay karo",
        "turant share karo",
        "immediately karo",
        "aaj hi",
        "24 ghante mein",
        "24 hours mein",
        "within 24 hours"
    ]

    urgency_signals = [
        word for word in urgency_keywords
        if word in lower_text
    ]

    # -------------------------
    # PAYMENT
    # -------------------------

    payment_keywords = [
        # English
        "send money",
        "send rs",
        "send ₹",
        "transfer",
        "payment",
        "pay",
        "upi",
        "refund",
        "bank account",
        "account number",
        "credit card",
        "debit card",
        "transaction",
        "deposit",
        "cash",

        # Hindi
        "भुगतान करें",
