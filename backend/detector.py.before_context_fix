    # -------------------------
    # PRIZE / REWARD SCAM
    # -------------------------

    prize_keywords = [
        # English
        "you won a cash prize",
        "you won a prize",
        "cash prize",
        "claim your prize",
        "claim the prize",
        "processing fee",
